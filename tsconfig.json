{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "openclaw/plugin-sdk/plugin-entry": ["./src/plugin/openclaw-sdk-stub.d.ts"]
    }
  },
  "include": ["src/**/*", "plugin/**/*"],
  "exclude": ["node_modules", "dist", "tests", "brain"]
}
